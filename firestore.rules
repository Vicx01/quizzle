// ---------------------------------------------------------------------------
// Quizzle — Firestore security rules
//
// STATUS: v3. REVISED. NOT DEPLOYED. NOT EXECUTED.
//
// v3 removes public/shared quiz reads entirely. Sharing is now resolved by the
// server-side API, which returns a sanitised quiz (see docs/SHARE_LINK_API.md).
// No client — authenticated or not — can read a quiz it does not own.
//
// Model (ARCHITECTURE.md §3.9): users, quizzes, quizAttempts, shareLinks,
// rateLimits.
//
// Principles:
//  - Deny by default. The catch-all denies anything not explicitly allowed,
//    including collections added later.
//  - Ownership derives from request.auth.uid, never from a client-supplied
//    field.
//  - Server-only collections deny client writes; the Admin SDK bypasses these
//    rules, which is how the share API reads quizzes and writes share links.
//
// REVIEW HISTORY
//  v1 — initial draft.
//  v2 — fixed two defects found by static review: malformed cross-document
//       paths (a generic doc(path) helper produced "/documents//quizzes/id"),
//       and a query-scaling defect where quizzes tested ownership via a
//       cross-document lookup instead of resource.data.
//  v3 — removed public/shared quiz reads. isSharedQuiz() allowed anonymous
//       reads of the whole quiz document, which embeds
//       questions[].correctAnswer and questions[].explanation, so anyone with a
//       live share link could read the answer key before attempting the quiz.
//       Share resolution now happens server-side and returns only the fields
//       needed to take the quiz.
// ---------------------------------------------------------------------------

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Cross-document helpers are written per collection with explicit path
    // literals. Do NOT reintroduce a generic doc(collectionPath) helper:
    // interpolating a string that already starts with "/" yields a double
    // slash and a malformed path.
    //
    // Each get()/exists() costs one document access against the per-request
    // limit, so these are used only where the data is genuinely elsewhere.

    function quizExists(quizId) {
      return exists(/databases/$(database)/documents/quizzes/$(quizId));
    }

    function quizOwnerId(quizId) {
      return get(/databases/$(database)/documents/quizzes/$(quizId)).data.get('ownerId', null);
    }

    function isQuizOwner(quizId) {
      return isSignedIn() && quizExists(quizId) && quizOwnerId(quizId) == uid();
    }

    // --------------------------------------------------------------- users
    // Document ID is the Firebase Auth UID.

    match /users/{userId} {
      allow read: if isSignedIn() && uid() == userId;

      allow create: if isSignedIn()
        && uid() == userId
        && request.resource.data.get('email', '') is string
        && request.resource.data.get('createdAt', null) != null;

      // Email is immutable: it identifies the account and must not be
      // swapped for another identity's address.
      allow update: if isSignedIn()
        && uid() == userId
        && request.resource.data.email == resource.data.email;

      // Account deletion must fan out to quizzes, attempts and share links,
      // so it is a server-side operation.
      allow delete: if false;
    }

    // ------------------------------------------------------------- quizzes
    //
    // OWNER ONLY. There is deliberately no public/shared read path.
    //
    // The quiz document embeds questions[].correctAnswer and
    // questions[].explanation. Granting read access to anyone other than the
    // owner would hand out the answer key, so shared quizzes are served by the
    // server-side API instead, which strips those fields
    // (docs/SHARE_LINK_API.md).
    //
    // A live shareLinks document therefore grants NO direct read access to the
    // quiz. That is intentional and covered by tests.
    //
    // The server reads quizzes with the Admin SDK, which bypasses these rules.

    match /quizzes/{quizId} {
      // resource.data.ownerId is on the document, so no cross-document lookup
      // is needed. That keeps list queries within the per-request access limit.
      allow read: if isSignedIn() && resource.data.get('ownerId', null) == uid();

      // Ownership is stamped from the auth UID, not taken from the client.
      allow create: if isSignedIn()
        && request.resource.data.get('ownerId', null) == uid()
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() <= 200
        && request.resource.data.get('deletedAt', null) == null;

      // ownerId is immutable, so ownership cannot be transferred by a write.
      allow update: if isSignedIn()
        && resource.data.get('ownerId', null) == uid()
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isSignedIn() && resource.data.get('ownerId', null) == uid();
    }

    // -------------------------------------------------------- quizAttempts

    match /quizAttempts/{attemptId} {
      // Readable by the person who attempted it, or by the quiz owner. The
      // quiz-owner branch needs a cross-document lookup, unlike quizzes above.
      allow read: if isSignedIn()
        && (resource.data.get('userId', null) == uid()
            || isQuizOwner(resource.data.get('quizId', '')));

      allow create: if isSignedIn()
        && request.resource.data.get('userId', null) == uid()
        && request.resource.data.get('quizId', '') is string
        && quizExists(request.resource.data.quizId);

      // Only the author of the attempt may modify or remove it.
      allow update, delete: if isSignedIn()
        && resource.data.get('userId', null) == uid();
    }

    // ---------------------------------------------------------- shareLinks
    //
    // Writes are server-only: a client must not be able to mint or revoke a
    // share link for its own quiz.
    //
    // Reads remain open so a client can resolve a token without a round trip,
    // but note this is NOT how shared quizzes are read any more — the quiz
    // itself is owner-only. This document only exposes quizId and counters,
    // and tokens are unguessable. If you want to tighten further, set this to
    // "if false" and resolve tokens exclusively through the API.

    match /shareLinks/{token} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------- rateLimits
    // Server-only bookkeeping. No client access of any kind.

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------ default
    // Deny everything not matched above, including future collections.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
