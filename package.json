{
  "name": "quizzle",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:rules": "jest --config jest.rules.config.js --runInBand",
    "test:db": "node --test tests/database/rls.test.mjs tests/database/schema.test.mjs tests/database/crud.test.mjs tests/database/share.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "functions:bundle": "node scripts/bundle-functions.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.17",
    "expo-router": "^3.0.0",
    "expo-status-bar": "~58.0.4",
    "firebase": "^11.0.1",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^4.14.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "ajv": "^8.20.0",
    "babel-preset-expo": "^58.0.19",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^4.0.0",
    "jest": "^29.0.0",
    "jest-expo": "^58.0.0",
    "prettier": "^3.0.0",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
