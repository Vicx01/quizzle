# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Environment files.
# SECURITY: ignore every .env variant with no exceptions. The previous pattern
# was `.env*.local`, which only matched files ENDING in `.local` — plain `.env`
# and `.env.production` were NOT ignored and would have been committed with real
# credentials.
#
# `.env` is the single environment file and is created manually. There is no
# committed template (`.env.example` was removed on the owner's request) — see
# docs/FIREBASE_SETUP.md for the values to put in it. Never commit real
# credentials.
.env
.env.*

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
